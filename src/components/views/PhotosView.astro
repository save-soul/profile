---
import { photos } from '../../data/photos';
import { type Locale, pick } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = (zh: string, en: string) => pick(locale, zh, en);
---

<div class="page-head">
  <h1>{t('相册', 'Photos')}</h1>
  <p class="subtitle">
    {t('一些片刻。悬停查看详情，点击放大。', 'Some moments. Hover for details, click to enlarge.')}
  </p>
</div>

<div class="photo-grid">
  {
    photos.map((photo) => (
      <figure
        class="photo-card"
        data-src={photo.src}
        data-title={pick(locale, photo.zh, photo.en)}
        data-desc={pick(locale, photo.zhDesc ?? '', photo.enDesc ?? '')}
        data-date={photo.date ?? ''}
        tabindex="0"
        role="button"
        aria-label={pick(locale, photo.zh, photo.en)}
      >
        <img src={photo.src} alt={pick(locale, photo.zh, photo.en)} loading="lazy" />
        <div class="photo-overlay">
          <p class="overlay-title">{pick(locale, photo.zh, photo.en)}</p>
          {photo.zhDesc && (
            <p class="overlay-desc">{pick(locale, photo.zhDesc, photo.enDesc)}</p>
          )}
          {photo.date && <p class="overlay-date">{photo.date}</p>}
        </div>
      </figure>
    ))
  }
</div>

<!-- 点击放大 lightbox -->
<div class="lightbox" id="lightbox" aria-hidden="true">
  <button class="lightbox-close" id="lightbox-close" aria-label={t('关闭', 'Close')}>×</button>
  <button class="lightbox-nav lightbox-prev" id="lb-prev" aria-label={t('上一张', 'Previous')}>‹</button>
  <button class="lightbox-nav lightbox-next" id="lb-next" aria-label={t('下一张', 'Next')}>›</button>
  <figure class="lightbox-inner">
    <img id="lb-img" src="" alt="" />
    <figcaption class="lightbox-caption">
      <p class="lb-title" id="lb-title"></p>
      <p class="lb-desc" id="lb-desc"></p>
      <p class="lb-date" id="lb-date"></p>
    </figcaption>
  </figure>
</div>

<script is:inline>
  (function () {
    var lb = document.getElementById('lightbox');
    if (!lb) return;
    var lbImg = document.getElementById('lb-img');
    var lbTitle = document.getElementById('lb-title');
    var lbDesc = document.getElementById('lb-desc');
    var lbDate = document.getElementById('lb-date');

    var cards = Array.prototype.slice.call(document.querySelectorAll('.photo-card'));
    var current = 0;

    function render(i) {
      var card = cards[i];
      if (!card) return;
      lbImg.src = card.getAttribute('data-src') || '';
      lbImg.alt = card.getAttribute('data-title') || '';
      lbTitle.textContent = card.getAttribute('data-title') || '';
      lbDesc.textContent = card.getAttribute('data-desc') || '';
      lbDate.textContent = card.getAttribute('data-date') || '';
    }
    function open(card) {
      current = cards.indexOf(card);
      if (current < 0) current = 0;
      render(current);
      lb.classList.add('open');
      lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
    function close() {
      lb.classList.remove('open');
      lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
    function prev() {
      current = (current - 1 + cards.length) % cards.length;
      render(current);
    }
    function next() {
      current = (current + 1) % cards.length;
      render(current);
    }

    cards.forEach(function (card) {
      card.addEventListener('click', function () { open(card); });
      card.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(card);
        }
      });
    });

    document.getElementById('lightbox-close').addEventListener('click', close);
    document.getElementById('lb-prev').addEventListener('click', function (e) { e.stopPropagation(); prev(); });
    document.getElementById('lb-next').addEventListener('click', function (e) { e.stopPropagation(); next(); });
    lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
    document.addEventListener('keydown', function (e) {
      if (!lb.classList.contains('open')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') prev();
      else if (e.key === 'ArrowRight') next();
    });
  })();
</script>
