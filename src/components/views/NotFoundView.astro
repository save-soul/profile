---
interface Props {
  /** 当前语言：中文默认，英文带 /en/ 前缀 */
  locale?: 'zh' | 'en';
}
const { locale = 'zh' } = Astro.props;

const home = locale === 'zh' ? '/' : '/en/';

const t =
  locale === 'zh'
    ? {
        title: '这一页走丢了',
        desc: '你访问的链接可能已移动或删除。',
        home: '← 返回首页',
        navLabel: '返回导航',
      }
    : {
        title: 'This page took a wrong turn',
        desc: 'The page you’re looking for may have moved or no longer exists.',
        home: '← Back home',
        navLabel: 'Back navigation',
      };
---

<section class="notfound">
  <p class="nf-code">404</p>
  <h1 class="nf-title">{t.title}</h1>
  <p class="nf-desc">{t.desc}</p>
  <nav class="nf-links" aria-label={t.navLabel}>
    <a href={home} class="nf-home">{t.home}</a>
  </nav>
</section>

<style>
  .notfound {
    text-align: center;
    padding-top: clamp(64px, 14vh, 140px);
    padding-bottom: var(--sp-16);
  }

  /* 大号衬线 404，呼应首页 Hero 的视觉语言 */
  .nf-code {
    font-family: var(--font-serif);
    font-size: clamp(96px, 18vw, 200px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .nf-title {
    margin-top: var(--sp-4);
    font-size: var(--fs-26);
    font-weight: 700;
    line-height: 1.4;
  }

  .nf-desc {
    margin-top: var(--sp-3);
    font-size: var(--fs-17);
    color: var(--ink-faint);
  }

  .nf-links {
    margin-top: var(--sp-10);
  }

  /* 圆角描边按钮：hover 反色，维持黑白极简语言 */
  .nf-home {
    display: inline-block;
    font-size: var(--fs-17);
    color: var(--ink);
    border: 1px solid var(--ink);
    border-radius: 999px;
    padding: var(--sp-3) var(--sp-8);
    transition: background var(--ease), color var(--ease);
  }
  .nf-home:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
</style>
