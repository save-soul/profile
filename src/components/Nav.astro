---
import { navLinks } from '../data/nav';
import { site } from '../data/site';
import { type Locale, localizedUrl, otherLocale } from '../i18n';

interface Props {
  active?: string;
  locale?: Locale;
  /** 单页内联双语（404）：语言按钮改为页面内切换，不跳 /en/ URL */
  bilingualInline?: boolean;
}
const { active = '', locale = 'zh', bilingualInline = false } = Astro.props;

// 语言切换：跳转到对应语言的同一页面
const switchUrl = localizedUrl(otherLocale(locale), Astro.url.pathname);
// 英文版导航链接统一加 /en 前缀；外站链接保持原样
const prefix = locale === 'en' ? '/en' : '';
---

<header class="site-header">
  <div class="header-inner">
    <a href={locale === 'en' ? '/en/' : '/'} class="site-logo" id="site-logo">
      {bilingualInline ? (
        <>
          <span class="zh">{site.name}</span>
          <span class="en">{site.nameEn}</span>
        </>
      ) : locale === 'zh' ? site.name : site.nameEn}
    </a>
    <div class="nav-wrap">
      <nav class="site-nav" id="site-nav" aria-label="主导航">
        {
          navLinks.map((link) => (
            <a
              href={link.external ? link.href : `${prefix}${link.href}`}
              class={active === link.key ? 'active' : ''}
              {...(link.external
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              {bilingualInline ? (
                <>
                  <span class="zh">{link.zh}</span>
                  <span class="en">{link.en}</span>
                </>
              ) : locale === 'zh' ? link.zh : link.en}
              {link.external && (
                <span class="ext" aria-hidden="true">
                  ↗
                </span>
              )}
            </a>
          ))
        }
      </nav>
      {
        bilingualInline ? (
          <button
            class="lang-toggle"
            id="lang-toggle-btn"
            type="button"
            aria-label="切换语言 / Switch language"
          >
            EN
          </button>
        ) : (
          <a
            class="lang-toggle"
            href={switchUrl}
            aria-label={locale === 'zh' ? '切换到英文 / Switch to English' : '切换到中文 / Switch to Chinese'}
          >
            {locale === 'zh' ? 'EN' : '中文'}
          </a>
        )
      }
      <button
        class="menu-toggle"
        id="menu-toggle"
        aria-label={locale === 'zh' ? '菜单 / Menu' : 'Menu'}
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    /* 移动端汉堡菜单 */
    var menuBtn = document.getElementById('menu-toggle');
    var nav = document.getElementById('site-nav');
    if (menuBtn && nav) {
      var setOpen = function (open) {
        nav.classList.toggle('open', open);
        menuBtn.classList.toggle('open', open);
        menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      menuBtn.addEventListener('click', function () {
        setOpen(!nav.classList.contains('open'));
      });
      /* 点击任一链接后收起菜单 */
      nav.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () {
          setOpen(false);
        });
      });
    }
  })();
</script>
