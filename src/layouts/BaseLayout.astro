---
import Nav from '../components/Nav.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  /** 页面名（无需带站名，layout 会自动追加「· 站名」） */
  title: string;
  /** 页面描述（用于 meta description / OG / Twitter）。默认取站点描述 */
  description?: string;
  /** 当前导航高亮 key */
  active?: string;
  /** 社交分享图（放 public/ 下，建议 1200×630 PNG）。默认取站点级 ogImage */
  ogImage?: string;
}

const { title, description = site.descriptionZh, active = '', ogImage = site.ogImage } = Astro.props;

// 绝对地址：canonical / OG / Twitter / sitemap 都需要完整 URL
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageAbs = new URL(ogImage, site.url).href;
const fullTitle = `${title} · ${site.name}`;

// 结构化数据：个人主页用 Person 类型，帮助搜索引擎理解作者与站点关系
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author,
  alternateName: site.authorEn,
  url: site.url,
  email: `mailto:${site.email}`,
  image: ogImageAbs
};
---

<!doctype html>
<html lang="zh-CN" data-lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- 基础 SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="author" content={site.author} />

    <!-- 图标：PNG 供现代浏览器，ICO 作通用回退 -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- 开放图谱 Open Graph（社交分享） -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:locale:alternate" content={site.localeAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:site" content={site.twitter} />

    <!-- 多语言声明（同 URL 双语站，指向自身并声明默认） -->
    <link rel="alternate" hreflang="zh-CN" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- 结构化数据 -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <!-- 在渲染前恢复语言偏好，避免闪烁 -->
    <script is:inline>
      (function () {
        var lang = 'zh';
        try {
          lang = localStorage.getItem('site-lang') || 'zh';
        } catch (e) {}
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.setAttribute('lang', lang === 'zh' ? 'zh-CN' : 'en');
      })();
    </script>
  </head>
  <body>
    <Nav active={active} />
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        <span class="zh">© 2026 {site.name} · 用 Astro 构建</span>
        <span class="en">© 2026 {site.nameEn} · Built with Astro</span>
      </p>
    </footer>
  </body>
</html>
