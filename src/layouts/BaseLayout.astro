---
import Nav from '../components/Nav.astro';
import { site } from '../data/site';
import { type Locale, localizedUrl, pageMeta } from '../i18n';
import '../styles/global.css';

interface Props {
  /** 页面名（无需带站名，layout 会自动追加「· 站名」） */
  title: string;
  /** 页面描述（用于 meta description / OG / Twitter）。默认取站点描述 */
  description?: string;
  /** 当前导航高亮 key */
  active?: string;
  /** 社交分享图（放 public/ 下，建议 1200×630 PNG）。默认取站点级 ogImage */
  ogImage?: string;
  /** 是否禁止搜索引擎收录（如 404 等错误页应设为 true） */
  noindex?: boolean;
  /** 当前语言：中文默认无前缀，英文带 /en/ 前缀 */
  locale?: Locale;
  /** 单页内联双语（仅 404 用：用 data-lang 切换，不拆 /en/ URL） */
  bilingualInline?: boolean;
}
const {
  title,
  description = site.descriptionZh,
  active = '',
  ogImage = site.ogImage,
  noindex = false,
  locale = 'zh',
  bilingualInline = false,
} = Astro.props;

const siteUrl = site.url;
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageAbs = new URL(ogImage, siteUrl).href;
const fullTitle = locale === 'zh' ? `${title} · ${site.name}` : `${title} · ${site.nameEn}`;

// 多语言互指 URL（绝对地址）：中文版无前缀，英文版带 /en/
const zhUrl = new URL(localizedUrl('zh', Astro.url.pathname), siteUrl).href;
const enUrl = new URL(localizedUrl('en', Astro.url.pathname), siteUrl).href;

const ogLocale = locale === 'zh' ? site.locale : site.localeAlt;
const ogLocaleAlt = locale === 'zh' ? site.localeAlt : site.locale;

// 关键词：优先取本页 keywords，兜底用站点级
const meta = active && pageMeta[active] ? pageMeta[active] : null;
const keywords = meta
  ? locale === 'zh' ? meta.keywordsZh : meta.keywordsEn
  : locale === 'zh' ? site.keywordsZh : site.keywordsEn;

// OG/Twitter 分享图替代文本
const ogImageAlt =
  locale === 'zh' ? `${site.name} · 个人主页分享图` : `${site.nameEn} · personal homepage card`;

// robots 指令：错误页 noindex，正常页显式 index,follow 并允许大图预览
const robotsContent = noindex ? 'noindex' : 'index,follow,max-image-preview:large,max-snippet:-1';

// 结构化数据：WebSite + Person + 按页面类型 + 图片 + 面包屑，组成 @graph 增强搜索富展示
const isHome = active === 'home' || active === '';
const homeUrl = locale === 'zh' ? `${siteUrl}/` : `${siteUrl}/en/`;
const langCode = locale === 'zh' ? 'zh-CN' : 'en';
const pageTypeMap: Record<string, string> = {
  home: 'WebPage',
  about: 'AboutPage',
  works: 'CollectionPage',
  photos: 'ImageGallery',
  reading: 'CollectionPage',
  now: 'AboutPage',
  notes: 'CollectionPage',
};
const pageType = pageTypeMap[active] || 'WebPage';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: locale === 'zh' ? site.name : site.nameEn,
      url: siteUrl,
      description: locale === 'zh' ? site.descriptionZh : site.descriptionEn,
      inLanguage: langCode,
      publisher: { '@id': `${siteUrl}/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: site.author,
      alternateName: site.authorEn,
      url: siteUrl,
      email: `mailto:${site.email}`,
      image: ogImageAbs,
      sameAs: [site.github],
    },
    {
      '@type': pageType,
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: fullTitle,
      description: description,
      inLanguage: langCode,
      isPartOf: { '@id': `${siteUrl}/#website` },
      primaryImageOfPage: { '@id': `${pageUrl}#primaryimage` },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
    },
    {
      '@type': 'ImageObject',
      '@id': `${pageUrl}#primaryimage`,
      url: ogImageAbs,
      width: 1200,
      height: 630,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: locale === 'zh' ? '首页' : 'Home',
          item: homeUrl,
        },
        ...(isHome
          ? []
          : [
              {
                '@type': 'ListItem',
                position: 2,
                name: title,
                item: pageUrl,
              },
            ]),
      ],
    },
  ],
};
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- 单页内联双语（仅 404）：加载前先按偏好设定 data-lang，避免英文偏好用户闪现中文 -->
    {
      bilingualInline && (
        <script is:inline>
          (function () {
            try {
              if (localStorage.getItem('lang') === 'en') {
                document.documentElement.setAttribute('data-lang', 'en');
              }
            } catch (e) {}
          })();
        </script>
      )
    }
    <meta name="generator" content={Astro.generator} />

    <!-- 基础 SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="author" content={site.author} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robotsContent} />

    <!-- 图标：PNG 供现代浏览器，ICO 作通用回退 -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- 开放图谱 Open Graph（社交分享） -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={locale === 'zh' ? site.name : site.nameEn} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="twitter:site" content={site.twitter} />

    <!-- 多语言 hreflang 互指：指向「不同 URL 的语言版本」，符合 Google/Baidu 规范 -->
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={zhUrl} />

    <!-- 结构化数据 -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <Nav active={active} locale={locale} bilingualInline={bilingualInline} />
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        {bilingualInline ? (
          <>
            <span class="zh">© 2026 {site.name} · 用 Astro 构建</span>
            <span class="en">© 2026 {site.nameEn} · Built with Astro</span>
          </>
        ) : locale === 'zh' ? `© 2026 ${site.name} · 用 Astro 构建` : `© 2026 ${site.nameEn} · Built with Astro`}
      </p>
    </footer>

    <!-- 单页内联双语（仅 404）：导航语言按钮改为页面内切换 data-lang，不跳 /en/ URL -->
    {
      bilingualInline && (
        <script is:inline>
          (function () {
            function applyLang(lang) {
              document.documentElement.setAttribute('data-lang', lang);
              document.documentElement.setAttribute('lang', lang === 'en' ? 'en' : 'zh-CN');
              var btn = document.getElementById('lang-toggle-btn');
              if (btn) btn.textContent = lang === 'en' ? '中文' : 'EN';
              var home = document.getElementById('nf-home');
              if (home) home.setAttribute('href', lang === 'en' ? '/en/' : '/');
              var logo = document.getElementById('site-logo');
              if (logo) logo.setAttribute('href', lang === 'en' ? '/en/' : '/');
              var menu = document.getElementById('menu-toggle');
              if (menu) menu.setAttribute('aria-label', lang === 'en' ? 'Menu / 菜单' : '菜单 / Menu');
              try { localStorage.setItem('lang', lang); } catch (e) {}
            }
            var saved;
            try { saved = localStorage.getItem('lang'); } catch (e) { saved = null; }
            applyLang(saved === 'en' ? 'en' : 'zh');
            var btn = document.getElementById('lang-toggle-btn');
            if (btn) {
              btn.addEventListener('click', function () {
                var cur = document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'zh';
                applyLang(cur === 'en' ? 'zh' : 'en');
              });
            }
          })();
        </script>
      )
    }
  </body>
</html>
