---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content as ZhContent } from '../content/now/zh.md';
import { Content as EnContent } from '../content/now/en.md';

// 最后更新时间 = 构建（astro build）时渲染的时刻，静态冻结；
// dev 模式下为页面渲染时的当前时刻。
// 格式：ISO 8601 扩展（YYYY-MM-DD HH:mm:ss +08:00），固定中国标准时间
// Asia/Shanghai(UTC+8)，精确到秒并注明时区。
function fmtNow(d: Date): string {
  const s = new Intl.DateTimeFormat('sv-SE', {
    timeZone: 'Asia/Shanghai',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hour12: false,
  }).format(d);
  return `${s} +08:00`;
}
const updatedAt = fmtNow(new Date());
const updatedIso = updatedAt.replace(' ', 'T'); // 严格 ISO 8601（带 T）供 <time datetime>
---

<BaseLayout title="现在" description="此刻我把时间花在哪里。" active="now" ogImage="/og-now.png">
  <div class="page-head">
    <h1><span class="zh">现在</span><span class="en">Now</span></h1>
    <p class="subtitle">
      <span class="zh">此刻我把时间花在哪里。</span>
      <span class="en">Where my time goes right now.</span>
    </p>
  </div>

  <div class="prose zh"><ZhContent /></div>
  <div class="prose en"><EnContent /></div>

  <p class="updated-at">
    <span class="zh">最后更新：</span><span class="en">Last updated: </span>
    <time datetime={updatedIso}>{updatedAt}</time>
  </p>
</BaseLayout>
