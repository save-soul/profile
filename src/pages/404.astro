---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="页面未找到"
  description="抱歉，你访问的页面不存在。"
  active=""
  ogImage="/og-index.png"
  noindex={true}
  bilingualInline={true}
>
  <section class="notfound">
    <p class="nf-code">404</p>

    <h1 class="nf-title">
      <span class="zh">这一页走丢了</span>
      <span class="en">This page took a wrong turn</span>
    </h1>

    <p class="nf-desc">
      <span class="zh">你访问的链接可能已移动或删除。</span>
      <span class="en">The page you’re looking for may have moved or no longer exists.</span>
    </p>

    <a href="/" id="nf-home" class="nf-home">
      <span class="zh">← 返回首页</span>
      <span class="en">← Back home</span>
    </a>
  </section>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding-top: clamp(64px, 14vh, 140px);
    padding-bottom: var(--sp-16);
  }

  .nf-code {
    font-family: var(--font-serif);
    font-size: clamp(96px, 18vw, 200px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .nf-title {
    margin-top: var(--sp-4);
    font-size: var(--fs-26);
    font-weight: 700;
    line-height: 1.4;
  }

  .nf-desc {
    margin-top: var(--sp-3);
    font-size: var(--fs-17);
    color: var(--ink-faint);
  }

  .nf-home {
    display: inline-block;
    margin-top: var(--sp-10);
    font-size: var(--fs-17);
    color: var(--ink);
    border: 1px solid var(--ink);
    border-radius: 999px;
    padding: var(--sp-3) var(--sp-8);
    transition: background var(--ease), color var(--ease);
  }
  .nf-home:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
</style>
